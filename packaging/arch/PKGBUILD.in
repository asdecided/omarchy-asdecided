# Generated by prepare.sh from an exact repository commit.
pkgname=asdecided-desktop
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native workspace for engineering decisions, backed by AsDecided core'
arch=('x86_64')
url='https://github.com/asdecided/omarchy-asdecided'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-utils')
makedepends=('cmake' 'rust' 'git')
checkdepends=('desktop-file-utils')
options=('!lto' '!debug')
source=("asdecided-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

prepare() {
    cd "asdecided-${pkgver}"
    export CARGO_HOME="$srcdir/cargo-home"
    cargo fetch --locked
}

build() {
    cd "asdecided-${pkgver}"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$PWD/target"
    cargo build --release --frozen
    cmake -S . -B build -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build build --parallel 2
}

check() {
    cd "asdecided-${pkgver}"
    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$PWD/target"
    export XDG_CACHE_HOME="$srcdir/check-cache"
    export QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software
    export ASDECIDED_BACKEND="$PWD/target/debug/asdecided-desktop-backend"
    cargo test --frozen
    ctest --test-dir build --output-on-failure
    ./build/asdecided --smoke-test "$PWD/tests/fixture" 2> build/arch-qml.log
    cat build/arch-qml.log
    ! grep -E 'qrc:|failed to load component' build/arch-qml.log
    desktop-file-validate packaging/io.github.asdecided.AsDecided.desktop
}

package() {
    cd "asdecided-${pkgver}"
    DESTDIR="$pkgdir" cmake --install build
}
